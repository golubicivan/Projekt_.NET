@model List<Table>
@{
    var isAdmin = User.IsInRole("Admin");
}

@if (!Model.Any())
{
    <div class="ze-empty-state" style="text-align:center;padding:60px 20px">
        <p class="text-muted-ze">Nema stolova.</p>
    </div>
}
else
{
    <table class="ze-table">
        <thead>
            <tr>
                <th>#</th><th>Lokacija</th><th>Stol</th><th>Mjesta</th><th>Zona</th>
                @if (isAdmin) { <th>Akcije</th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td class="text-muted-ze">#@t.Id</td>
                    <td><a href="/lokacija/@t.VenueId" style="color:#7c3aed;text-decoration:none">@t.Venue?.Name</a></td>
                    <td style="font-weight:600">Stol @t.TableNumber</td>
                    <td class="text-muted-ze">@t.SeatCount mjesta</td>
                    <td><span class="@(t.Zone == TableZone.VIP ? "zone-vip" : "zone-regular")">@t.Zone</span></td>
                    @if (isAdmin)
                    {
                        <td>
                            <a href="/Table/Edit/@t.Id" class="btn-mini btn-edit">✎</a>
                            <form method="post" action="/Table/Delete/@t.Id" style="display:inline"
                                  data-confirm-delete="Obrisati stol #@t.TableNumber?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-mini btn-del">🗑️</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
<style>
.btn-mini { background: transparent; border: none; cursor: pointer; padding: 4px 8px; border-radius: 6px; font-size: 0.85rem; text-decoration: none; color: #94a3b8; transition: all 0.15s; }
.btn-mini:hover { background: rgba(124,58,237,0.2); }
.btn-del:hover { background: rgba(239,68,68,0.2); color: #ef4444; }
</style>
