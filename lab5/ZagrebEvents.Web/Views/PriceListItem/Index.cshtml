@model List<PriceListItem>
@{
    ViewData["Title"] = "Cjenik";
    var isAdmin = User.IsInRole("Admin");
}

@section Breadcrumbs {
<nav class="ze-breadcrumb"><a href="/">Karta</a> › <span>Cjenik</span></nav>
}

<div class="ze-page-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px">
    <div>
        <h1>Cjenik</h1>
        <p class="text-muted-ze">Pretraži po artiklu, kategoriji ili lokaciji</p>
    </div>
    @if (isAdmin)
    {
        <a href="/PriceListItem/Create" class="btn-primary-custom">➕ Nova stavka</a>
    }
</div>

@if (TempData["Success"] != null) { <div class="ze-alert-success" style="margin-bottom:16px">✓ @TempData["Success"]</div> }

<form data-ajax-search="/PriceListItem/SearchPartial" data-target="#pli-list" style="margin-bottom:24px">
    <div style="position:relative">
        <input type="text" name="q" value="@ViewBag.Query" placeholder="Pretraži cjenik..."
               class="ze-input" style="padding-left:42px" autocomplete="off" />
        <span style="position:absolute;left:14px;top:13px;opacity:0.5">🔍</span>
    </div>
</form>

<div id="pli-list">
    @await Html.PartialAsync("_PriceListItemListPartial", Model)
</div>
