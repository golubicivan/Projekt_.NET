@model List<Venue>
@{
    ViewData["Title"] = "GdjeCemo - Karta";
    Layout = "_Layout";
}

<div class="map-page">
    <div id="map"></div>

    <!-- Filter po tipu eventa -->
    <div class="map-filter" id="mapFilter">
        <button type="button" class="filter-title" id="filterToggle" aria-expanded="true">
            <span>Prikaži na karti</span>
            <span class="filter-chevron">▾</span>
        </button>
        <div class="filter-body" id="filterBody">
            <label class="filter-item"><input type="checkbox" class="type-filter" value="DJNight" checked /> <span class="legend-dot" style="border-color:#7c3aed">🪩</span> DJ Noć</label>
            <label class="filter-item"><input type="checkbox" class="type-filter" value="Concert" checked /> <span class="legend-dot" style="border-color:#ef4444">🎤</span> Koncert</label>
            <label class="filter-item"><input type="checkbox" class="type-filter" value="PubQuiz" checked /> <span class="legend-dot" style="border-color:#f59e0b">📖</span> Pub Quiz</label>
            <label class="filter-item"><input type="checkbox" class="type-filter" value="Festival" checked /> <span class="legend-dot" style="border-color:#f97316">🎪</span> Festival</label>
            <div class="filter-hint">Obrub pina = tip eventa · ⭐ = istaknuto</div>
        </div>
    </div>
</div>

@section Scripts {
<link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
<link rel="stylesheet" href="~/lib/markercluster/MarkerCluster.css" />
<script src="~/lib/leaflet/leaflet.js"></script>
<script src="~/lib/markercluster/leaflet.markercluster.js"></script>
<script>
    const venues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(v => new {
        id = v.Id,
        name = v.Name,
        initials = v.Initials,
        logoUrl = v.LogoUrl,
        lat = v.Latitude,
        lng = v.Longitude,
        upcomingEvent = v.Events
            .Where(e => e.StartTime > DateTime.Now && e.DeletedAt == null)
            .OrderBy(e => e.StartTime)
            .Select(e => new {
                id = e.Id,
                name = e.Name,
                type = e.Type.ToString(),
                typeIcon = e.TypeIcon,
                typeColor = e.TypeColor,
                typeLabel = e.TypeLabel,
                posterUrl = e.PosterUrl,
                startTime = e.StartTime.ToString("dd.MM.yyyy HH:mm"),
                entryPrice = e.EntryPrice,
                isFeatured = e.IsFeatured
            })
            .FirstOrDefault()
    })));

    const map = L.map('map', { zoomControl: false, minZoom: 10 }).setView([45.812, 15.975], 12);
    L.control.zoom({ position: 'bottomright' }).addTo(map);

    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>',
        maxZoom: 19
    }).addTo(map);

    function escapeHtml(t) { var d = document.createElement('div'); d.textContent = t == null ? '' : t; return d.innerHTML; }

    // Cluster grupa (preklapajuci pinovi -> jedan krug s brojem)
    const cluster = L.markerClusterGroup({
        maxClusterRadius: 55,
        showCoverageOnHover: false,
        iconCreateFunction: c => L.divIcon({
            html: '<div class="ze-cluster"><span>' + c.getChildCount() + '</span></div>',
            className: '', iconSize: [46, 46]
        })
    });

    // Spremi sve markere s tipom (za filtriranje)
    const allMarkers = []; // { marker, type }

    venues.forEach(venue => {
        if (!venue.upcomingEvent) return;
        const ev = venue.upcomingEvent;
        const color = ev.typeColor;

        // Sadržaj kruga: logo (ako postoji) ili inicijali venuea
        const inner = venue.logoUrl
            ? `<img class="pin-logo" src="${venue.logoUrl}?v=3" alt="" loading="eager" onerror="this.parentNode.innerHTML='${escapeHtml(venue.initials)}'"/>`
            : `<span class="pin-initials">${escapeHtml(venue.initials)}</span>`;

        const featuredCls = ev.isFeatured ? ' pin-featured' : '';
        const star = ev.isFeatured ? '<span class="pin-star">⭐</span>' : '';

        const markerHtml = `
            <div class="venue-pin${featuredCls}" style="--pin-color:${color}">
                <div class="pin-ring">${inner}${star}</div>
            </div>`;

        const icon = L.divIcon({ html: markerHtml, className: '', iconSize: [54, 54], iconAnchor: [27, 27] });

        const price = ev.entryPrice == 0 ? 'Besplatno' : (ev.entryPrice + ' EUR');
        const popupHtml = `
            <div class="pin-popup">
                <img src="${ev.posterUrl}" alt="${escapeHtml(ev.name)}" onerror="this.src='https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?w=400'"/>
                <div class="pin-popup-body">
                    <div class="pin-popup-badge" style="background:${color}">${ev.typeIcon} ${escapeHtml(ev.typeLabel)}${ev.isFeatured ? ' ⭐' : ''}</div>
                    <div class="pin-popup-venue">📍 ${escapeHtml(venue.name)}</div>
                    <div class="pin-popup-event">${escapeHtml(ev.name)}</div>
                    <div class="pin-popup-meta">📅 ${escapeHtml(ev.startTime)} · <span style="color:#10b981">${price}</span></div>
                    <a href="/Event/Details/${ev.id}" class="pin-popup-btn">Otvori event →</a>
                </div>
            </div>`;

        const marker = L.marker([venue.lat, venue.lng], { icon });
        marker.bindPopup(popupHtml, { className: 'ze-popup', minWidth: 260, maxWidth: 280 });
        allMarkers.push({ marker, type: ev.type });
    });

    function refreshMarkers() {
        const active = Array.from(document.querySelectorAll('.type-filter:checked')).map(c => c.value);
        cluster.clearLayers();
        allMarkers.forEach(m => { if (active.includes(m.type)) cluster.addLayer(m.marker); });
    }

    document.querySelectorAll('.type-filter').forEach(cb => cb.addEventListener('change', refreshMarkers));

    // Sklapanje/širenje panela filtera
    (function () {
        const panel = document.getElementById('mapFilter');
        const toggle = document.getElementById('filterToggle');
        if (!panel || !toggle) return;
        // na malim ekranima kreni sklopljeno
        if (window.matchMedia('(max-width: 600px)').matches) {
            panel.classList.add('collapsed');
            toggle.setAttribute('aria-expanded', 'false');
        }
        toggle.addEventListener('click', function () {
            const collapsed = panel.classList.toggle('collapsed');
            toggle.setAttribute('aria-expanded', String(!collapsed));
        });
    })();

    map.addLayer(cluster);
    refreshMarkers();
</script>
}

<style>
.map-page { position: fixed; top: 60px; left: 0; right: 0; bottom: 0; overflow: hidden; }
#map { width: 100%; height: 100%; }

/* Filter kontrola */
.map-filter {
    position: absolute; top: 16px; left: 16px;
    background: rgba(18, 18, 26, 0.94); border: 1px solid rgba(124, 58, 237, 0.3);
    border-radius: 12px; padding: 12px 14px; z-index: 1000; backdrop-filter: blur(8px);
    min-width: 160px;
}
.filter-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #64748b; margin-bottom: 8px; font-weight: 700; background: none; border: none; cursor: pointer; padding: 0; font-family: inherit; }
.filter-title:hover { color: #a78bfa; }
.filter-chevron { transition: transform 0.25s ease; font-size: 0.9rem; }
.map-filter.collapsed .filter-chevron { transform: rotate(-90deg); }
.filter-body { overflow: hidden; transition: max-height 0.28s ease, opacity 0.2s ease; max-height: 320px; opacity: 1; }
.map-filter.collapsed .filter-body { max-height: 0; opacity: 0; }
.map-filter.collapsed .filter-title { margin-bottom: 0; }
.filter-item { display: flex; align-items: center; gap: 8px; font-size: 0.82rem; color: #cbd5e1; margin-bottom: 6px; cursor: pointer; }
.filter-item input { accent-color: #7c3aed; cursor: pointer; }
.filter-hint { font-size: 0.65rem; color: #64748b; margin-top: 6px; border-top: 1px solid rgba(255,255,255,0.06); padding-top: 6px; }
.legend-dot { width: 24px; height: 24px; border-radius: 50%; border: 2px solid; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; background: #1a1a2e; }

/* Venue pin: krug s logom/inicijalima, obrub = tip eventa */
.venue-pin { position: relative; width: 54px; height: 54px; cursor: pointer; }
.pin-ring {
    width: 48px; height: 48px; border-radius: 50%;
    background: #05050a; border: 3px solid var(--pin-color);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; box-shadow: 0 4px 14px rgba(0,0,0,0.55), 0 0 0 1px rgba(0,0,0,0.4) inset;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    margin: 3px;
}
.venue-pin:hover .pin-ring { transform: scale(1.12); box-shadow: 0 6px 22px var(--pin-color); }
.pin-logo { width: 100%; height: 100%; object-fit: cover; filter: saturate(1.15); }
.pin-initials { color: #f1f5f9; font-weight: 800; font-size: 1rem; letter-spacing: -0.5px; }
.pin-star { position: absolute; top: -4px; right: -4px; font-size: 0.9rem; filter: drop-shadow(0 0 3px gold); }

/* Featured spotlight - sareni pulsirajuci glow */
.pin-featured .pin-ring {
    border-color: #fff;
    animation: ze-spotlight 1.8s ease-in-out infinite;
}
@@keyframes ze-spotlight {
    0%   { box-shadow: 0 0 8px 2px #7c3aed, 0 0 14px 4px #ef4444; }
    33%  { box-shadow: 0 0 8px 2px #f59e0b, 0 0 14px 4px #06b6d4; }
    66%  { box-shadow: 0 0 8px 2px #10b981, 0 0 14px 4px #f97316; }
    100% { box-shadow: 0 0 8px 2px #7c3aed, 0 0 14px 4px #ef4444; }
}

/* Cluster */
.ze-cluster {
    width: 46px; height: 46px; border-radius: 50%;
    background: radial-gradient(circle, #7c3aed 0%, #5b21b6 100%);
    border: 3px solid rgba(255,255,255,0.4);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 800; font-size: 1.05rem;
    box-shadow: 0 4px 16px rgba(124,58,237,0.6);
}

/* Preview popup (dark) */
.ze-popup .leaflet-popup-content-wrapper { background: #12121a; color: #f1f5f9; border: 1px solid rgba(124,58,237,0.4); border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,0.6); padding: 0; overflow: hidden; }
.ze-popup .leaflet-popup-content { margin: 0; width: 100% !important; }
.ze-popup .leaflet-popup-tip { background: #12121a; border: 1px solid rgba(124,58,237,0.4); }
.ze-popup a.leaflet-popup-close-button { color: #94a3b8; padding: 6px 8px 0 0; }
.pin-popup img { width: 100%; height: 130px; object-fit: cover; display: block; }
.pin-popup-body { padding: 12px 14px 14px; }
.pin-popup-badge { display: inline-block; padding: 3px 9px; border-radius: 12px; color: #fff; font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 8px; }
.pin-popup-venue { font-size: 0.76rem; color: #94a3b8; margin-bottom: 3px; }
.pin-popup-event { font-size: 1rem; font-weight: 700; color: #f1f5f9; line-height: 1.3; margin-bottom: 6px; }
.pin-popup-meta { font-size: 0.76rem; color: #94a3b8; margin-bottom: 12px; }
.pin-popup-btn { display: block; text-align: center; background: #7c3aed; color: #fff !important; text-decoration: none; padding: 9px; border-radius: 8px; font-weight: 600; font-size: 0.85rem; transition: background 0.15s; }
.pin-popup-btn:hover { background: #6d28d9; }

.leaflet-control-zoom a { background: #1a1a2e !important; color: #f1f5f9 !important; border-color: rgba(124,58,237,0.4) !important; }
.leaflet-control-zoom a:hover { background: #7c3aed !important; }

@@media (max-width: 600px) {
    .map-filter { top: 10px; left: 10px; padding: 10px; min-width: 140px; }
    .filter-item { font-size: 0.78rem; }
}
</style>
