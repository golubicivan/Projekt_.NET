@model List<Attachment>

@if (!Model.Any())
{
    <p class="text-muted-ze" style="font-size:0.85rem">Još nema priloženih datoteka.</p>
}
else
{
    <div class="attachment-list">
        @foreach (var a in Model)
        {
            var isImage = a.ContentType.StartsWith("image/");
            <div class="attachment-item">
                @if (isImage)
                {
                    <a href="@a.FilePath" target="_blank"><img src="@a.FilePath" alt="@a.FileName" class="attachment-thumb" /></a>
                }
                else
                {
                    <a href="@a.FilePath" target="_blank" class="attachment-file-icon">📄</a>
                }
                <div class="attachment-info">
                    <a href="@a.FilePath" target="_blank" class="attachment-name">@a.FileName</a>
                    <span class="attachment-size">@(Math.Round(a.FileSize / 1024.0, 1)) KB</span>
                </div>
                <button type="button" class="attachment-del" onclick="deleteAttachment(@a.Id)" title="Obriši">🗑️</button>
            </div>
        }
    </div>
}

<style>
.attachment-list { display: flex; flex-direction: column; gap: 8px; }
.attachment-item { display: flex; align-items: center; gap: 10px; padding: 8px; background: #12121a; border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; }
.attachment-thumb { width: 48px; height: 48px; object-fit: cover; border-radius: 6px; }
.attachment-file-icon { font-size: 2rem; text-decoration: none; }
.attachment-info { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.attachment-name { color: #f1f5f9; font-size: 0.85rem; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.attachment-name:hover { color: #7c3aed; }
.attachment-size { color: #64748b; font-size: 0.72rem; }
.attachment-del { background: rgba(239,68,68,0.15); color: #ef4444; border: none; border-radius: 6px; width: 32px; height: 32px; cursor: pointer; transition: all 0.15s; }
.attachment-del:hover { background: #ef4444; color: #fff; }
</style>
