@model Event
@{
    ViewData["Title"] = $"Uredi: {Model.Name}";
}

@section Breadcrumbs {
<nav class="ze-breadcrumb">
    <a href="/">Karta</a> › <a href="/eventi">Svi eventi</a> ›
    <a href="/event/@Model.Id">@Model.Name</a> › <span>Uredi</span>
</nav>
}

<div class="ze-page-header">
    <h1>Uredi event</h1>
    <p class="text-muted-ze">@Model.Name</p>
</div>

<form asp-action="Edit" asp-controller="Event" asp-route-id="@Model.Id" method="post" class="ze-form" style="max-width:800px">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="ze-alert-danger" style="margin-bottom:16px"></div>

    <div class="form-group">
        <label asp-for="Name" class="ze-label">Naziv eventa *</label>
        <input asp-for="Name" class="ze-input" required />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="ze-label">Opis</label>
        <textarea asp-for="Description" class="ze-input" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-row">
        @await Html.PartialAsync("_DatePicker", new ZagrebEvents.Web.Models.DatePickerModel
        {
            Name = "StartTime",
            Value = Model.StartTime,
            Label = "Početak",
            IncludeTime = true,
            Required = true
        })
        @await Html.PartialAsync("_DatePicker", new ZagrebEvents.Web.Models.DatePickerModel
        {
            Name = "EndTime",
            Value = Model.EndTime,
            Label = "Kraj",
            IncludeTime = true,
            Required = true
        })
    </div>

    <div class="form-row">
        <div class="form-group">
            <label asp-for="Type" class="ze-label">Tip</label>
            <select asp-for="Type" class="ze-input">
                <option value="0" selected="@(Model.Type == EventType.DJNight)">🪩 DJ Noć</option>
                <option value="1" selected="@(Model.Type == EventType.Concert)">🎤 Koncert</option>
                <option value="2" selected="@(Model.Type == EventType.PubQuiz)">📖 Pub Quiz</option>
                <option value="3" selected="@(Model.Type == EventType.Festival)">🎪 Festival</option>
            </select>
        </div>
        <div class="form-group">
            @await Html.PartialAsync("_AutocompleteDropdown", new ZagrebEvents.Web.Models.AutocompleteModel
            {
                Name = "VenueId",
                InitialId = Model.VenueId,
                InitialLabel = Model.Venue?.Name ?? "",
                Endpoint = "/Api/SearchVenues",
                Label = "Lokacija",
                Placeholder = "Upiši ime lokacije...",
                Required = true
            })
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label asp-for="EntryPrice" class="ze-label">Cijena ulaza (€)</label>
            <input asp-for="EntryPrice" type="number" step="0.50" min="0" class="ze-input" />
        </div>
        <div class="form-group">
            <label asp-for="AgeLimit" class="ze-label">Dobna granica</label>
            <input asp-for="AgeLimit" type="number" min="0" max="99" class="ze-input" />
        </div>
    </div>

    <div class="form-group">
        <label asp-for="PosterUrl" class="ze-label">URL postera</label>
        <input asp-for="PosterUrl" type="url" class="ze-input" />
    </div>

    <div class="form-group">
        <label class="ze-checkbox">
            <input asp-for="IsFeatured" type="checkbox" />
            <span>⭐ Istakni ovaj event na karti (spotlight efekt)</span>
        </label>
    </div>

    <div style="display:flex;gap:12px;margin-top:24px">
        <button type="submit" class="btn-primary-custom" style="flex:1">Spremi promjene</button>
        <a href="/event/@Model.Id" class="btn-secondary-custom" style="flex:1;text-align:center">Odustani</a>
    </div>
</form>

@* ===================== DOKUMENTI / GALERIJA (Dropzone) ===================== *@
<div class="detail-section" style="max-width:800px;margin-top:24px">
    <h2>📎 Dokumenti i slike</h2>
    <p class="text-muted-ze" style="font-size:0.85rem">Povuci datoteke ovdje ili klikni za upload (slike i PDF, max 5 MB).</p>

    <form id="attachmentDz"
          action="/Event/UploadAttachment?eventId=@Model.Id"
          class="dropzone ze-dropzone"
          enctype="multipart/form-data">
        @Html.AntiForgeryToken()
    </form>

    <div id="attachmentList" style="margin-top:16px"></div>
</div>

@if (User.IsInRole("Admin"))
{
    <form method="post" action="/Event/Delete/@Model.Id"
          data-confirm-delete="Sigurno želiš obrisati event '@Model.Name'? (Soft delete - može se vratiti iz baze)"
          style="max-width:800px;margin-top:16px">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-danger-custom" style="width:100%">🗑️ Obriši event (soft delete)</button>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/dropzone@5/dist/min/dropzone.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/dropzone@5/dist/min/dropzone.min.js"></script>
    <script>
        Dropzone.autoDiscover = false;
        document.addEventListener('DOMContentLoaded', function () {
            var token = document.querySelector('#attachmentDz input[name="__RequestVerificationToken"]').value;
            var dz = new Dropzone("#attachmentDz", {
                paramName: "file",
                maxFilesize: 5, // MB
                acceptedFiles: "image/*,application/pdf",
                addRemoveLinks: false,
                dictDefaultMessage: "📤 Povuci datoteke ovdje ili klikni",
                headers: { "RequestVerificationToken": token },
                params: { __RequestVerificationToken: token }
            });
            dz.on("success", function (file) {
                dz.removeFile(file);
                loadAttachments();
            });
            loadAttachments();
        });

        function loadAttachments() {
            fetch("/Event/GetAttachments?eventId=@Model.Id")
                .then(r => r.text())
                .then(html => { document.getElementById("attachmentList").innerHTML = html; });
        }

        function deleteAttachment(id) {
            if (!confirm("Obrisati ovu datoteku?")) return;
            var token = document.querySelector('#attachmentDz input[name="__RequestVerificationToken"]').value;
            var fd = new FormData();
            fd.append("id", id);
            fd.append("__RequestVerificationToken", token);
            fetch("/Event/DeleteAttachment", { method: "POST", body: fd })
                .then(r => r.json())
                .then(() => loadAttachments());
        }
    </script>
}

<style>
.btn-danger-custom {
    background: rgba(239,68,68,0.15); color: #ef4444;
    border: 1px solid rgba(239,68,68,0.3); border-radius: 8px;
    padding: 10px 20px; font-weight: 600; cursor: pointer;
    transition: all 0.2s;
}
.btn-danger-custom:hover { background: #ef4444; color: #fff; }
</style>
