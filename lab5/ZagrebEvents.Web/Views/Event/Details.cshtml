@model Event
@{
    ViewData["Title"] = Model.Name;
    var freeTables = Model.Venue.Tables
        .Where(t => !Model.Reservations
            .Where(r => r.Status != ReservationStatus.Cancelled)
            .Select(r => r.Table?.Id)
            .Contains(t.Id))
        .ToList();
}

@section Breadcrumbs {
<nav class="ze-breadcrumb">
    <a href="/">Karta</a> › <a href="/Event/Index">Svi eventi</a> › <span>@Model.Name</span>
</nav>
}

@if (TempData["ReservationSuccess"] != null)
{
    <div class="ze-alert-success">✓ @TempData["ReservationSuccess"]</div>
}
@if (TempData["ReservationError"] != null)
{
    <div class="ze-alert-danger">✗ @TempData["ReservationError"]</div>
}

<div class="event-detail">
    <!-- Hero -->
    <div class="event-detail-hero">
        <img src="@Model.PosterUrl" alt="@Model.Name"
             onerror="this.src='https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?w=1200'" />
        <div class="event-detail-hero-overlay">
            <span class="event-badge" style="background:@Model.TypeColor">@Model.TypeIcon @Model.TypeLabel</span>
            <h1 class="event-detail-title">@Model.Name</h1>
            <div class="event-detail-venue-link">
                <a href="/Venue/Details/@Model.Venue.Id">📍 @Model.Venue.Name — @Model.Venue.Address</a>
            </div>
        </div>
    </div>

    <div class="event-detail-content">
        <!-- Lijevo: info + rezervacija -->
        <div class="event-detail-main">

            <!-- Opis -->
            <div class="detail-section">
                <h2>O eventu</h2>
                <p>@Model.Description</p>
            </div>

            <!-- Info kartica -->
            <div class="detail-section event-info-grid">
                <div class="ze-stat-card">
                    <div class="stat-label">Datum i vrijeme</div>
                    <div class="stat-value">@Model.StartTime.ToString("dd.MM.yyyy")</div>
                    <div class="stat-sub">@Model.StartTime.ToString("HH:mm") – @Model.EndTime.ToString("HH:mm")</div>
                </div>
                <div class="ze-stat-card">
                    <div class="stat-label">Ulaz</div>
                    <div class="stat-value" style="color:#10b981">
                        @(Model.EntryPrice == 0 ? "Besplatno" : $"{Model.EntryPrice:F2} EUR")
                    </div>
                </div>
                <div class="ze-stat-card">
                    <div class="stat-label">Dobna granica</div>
                    <div class="stat-value" style="color:@(Model.AgeLimit > 0 ? "#ef4444" : "#10b981")">
                        @(Model.AgeLimit > 0 ? $"{Model.AgeLimit}+" : "Bez limite")
                    </div>
                </div>
                <div class="ze-stat-card">
                    <div class="stat-label">Trajanje</div>
                    <div class="stat-value">@((int)Model.Duration.TotalHours)h @Model.Duration.Minutes min</div>
                </div>
            </div>

            <!-- Rezervacija stolova -->
            @if (Model.IsUpcoming)
            {
                <div class="detail-section">
                    <div style="display:flex;align-items:center;gap:10px">
                        <h2 style="margin:0">Rezervacija stola</h2>
                        <button type="button" id="floorplanBtn" class="floorplan-info-btn" title="Tlocrt i zauzetost stolova">ℹ️ Tlocrt &amp; zauzetost</button>
                    </div>
                    <p class="text-muted-ze" style="font-size:0.82rem;margin:6px 0 14px">
                        Slobodno: <b style="color:#10b981">@freeTables.Count</b> / @Model.Venue.Tables.Count stolova
                        @if (Model.AgeLimit > 0)
                        {
                            <span> · <b style="color:#f59e0b">@(Model.AgeLimit)+</b>
                            @if (!Model.Venue.IdentityRequired)
                            {
                                <span class="text-muted-ze">(klub ne provjerava osobne — rezervacija otvorena svima)</span>
                            }
                            </span>
                        }
                    </p>

                    @{ var policy = ViewBag.ReservationPolicy as ZagrebEvents.Web.Services.ReservationPolicy.Result; }
                    @if (policy != null && !policy.Allowed)
                    {
                        <div class="reserve-block">
                            <div class="reserve-block-title">🔒 Rezervacija nije moguća</div>
                            <p class="reserve-block-text">@policy.Reason</p>
                            @if (!string.IsNullOrEmpty(policy.ActionUrl))
                            {
                                <a href="@policy.ActionUrl" class="btn-primary-custom">@policy.ActionLabel</a>
                            }
                        </div>
                    }
                    else if (freeTables.Any())
                    {
                        <form action="/Event/Reserve" method="post" class="ze-form reservation-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="eventId" value="@Model.Id" />
                            <div class="form-row">
                                <div class="form-group">
                                    <label class="ze-label">Stol</label>
                                    <select name="tableId" class="ze-input" required>
                                        <option value="">Odaberi stol...</option>
                                        @foreach (var t in freeTables.OrderBy(t => t.TableNumber))
                                        {
                                            <option value="@t.Id">Stol @t.TableNumber — @(t.Zone == TableZone.VIP ? "VIP" : "Regular"), @t.SeatCount mjesta</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="ze-label">Broj gostiju</label>
                                    <input type="number" name="guests" class="ze-input" min="1" max="10" placeholder="npr. 4" required />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="ze-label">Napomena (opcionalno)</label>
                                <textarea name="note" class="ze-input" rows="2" placeholder="Posebni zahtjevi, proslava..."></textarea>
                            </div>
                            <button type="submit" class="btn-primary-custom" style="width:100%">Pošalji rezervaciju</button>
                        </form>
                    }
                    else
                    {
                        <div class="ze-alert-danger">Nema slobodnih stolova za ovaj event.</div>
                    }
                </div>
            }

            <!-- Rezervacije za TAJ event — samo Admin -->
            @if (User.IsInRole("Admin"))
            {
                var eventReservations = Model.Reservations.OrderByDescending(r => r.CreatedAt).ToList();
                <div class="detail-section">
                    <h2>🗓️ Rezervacije za ovaj event (@eventReservations.Count)</h2>
                    @if (eventReservations.Any())
                    {
                        <table class="ze-table" style="margin-top:12px">
                            <thead>
                                <tr><th>#</th><th>Korisnik</th><th>Stol</th><th>Gosti</th><th>Status</th><th>Kreirano</th><th>Akcije</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var r in eventReservations)
                                {
                                    <tr>
                                        <td class="text-muted-ze">#@r.Id</td>
                                        <td style="font-weight:600">@r.User?.FullName</td>
                                        <td class="text-muted-ze">Stol @r.Table?.TableNumber</td>
                                        <td class="text-muted-ze">@r.NumberOfGuests 👥</td>
                                        <td><span style="color:@r.StatusColor;font-weight:600">@r.StatusLabel</span></td>
                                        <td class="text-muted-ze">@r.CreatedAt.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            <div style="display:flex;gap:4px;flex-wrap:wrap">
                                                @if (r.Status != ReservationStatus.Confirmed)
                                                {
                                                    <form method="post" action="/Reservation/SetStatus/@r.Id" style="display:inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="status" value="@((int)ReservationStatus.Confirmed)" />
                                                        <input type="hidden" name="returnUrl" value="/event/@Model.Id" />
                                                        <button type="submit" class="btn-action btn-confirm" title="Potvrdi">✓</button>
                                                    </form>
                                                }
                                                @if (r.Status != ReservationStatus.Cancelled)
                                                {
                                                    <form method="post" action="/Reservation/SetStatus/@r.Id" style="display:inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="status" value="@((int)ReservationStatus.Cancelled)" />
                                                        <input type="hidden" name="returnUrl" value="/event/@Model.Id" />
                                                        <button type="submit" class="btn-action btn-cancel" title="Otkaži">✗</button>
                                                    </form>
                                                }
                                                @if (r.Status == ReservationStatus.Cancelled)
                                                {
                                                    <form method="post" action="/Reservation/SetStatus/@r.Id" style="display:inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="status" value="@((int)ReservationStatus.Pending)" />
                                                        <input type="hidden" name="returnUrl" value="/event/@Model.Id" />
                                                        <button type="submit" class="btn-action btn-pending" title="Vrati na čekanje">⏳</button>
                                                    </form>
                                                }
                                                <a href="/Reservation/Details/@r.Id" class="btn-action btn-detail" title="Detalji">👁</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted-ze">Nema rezervacija za ovaj event.</p>
                    }
                </div>

                <style>
                    .btn-action { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 6px; border: none; font-size: 0.85rem; font-weight: 700; cursor: pointer; text-decoration: none; transition: all 0.15s; }
                    .btn-confirm { background: rgba(16,185,129,0.15); color: #10b981; }
                    .btn-confirm:hover { background: #10b981; color: #fff; }
                    .btn-cancel { background: rgba(239,68,68,0.15); color: #ef4444; }
                    .btn-cancel:hover { background: #ef4444; color: #fff; }
                    .btn-pending { background: rgba(245,158,11,0.15); color: #f59e0b; }
                    .btn-pending:hover { background: #f59e0b; color: #fff; }
                    .btn-detail { background: rgba(255,255,255,0.05); color: #94a3b8; }
                    .btn-detail:hover { background: rgba(124,58,237,0.2); color: #7c3aed; }
                </style>
            }

            <!-- Recenzije -->
            <div class="detail-section">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
                    <h2 style="margin:0">Recenzije <span class="text-muted-ze">(@Model.Reviews.Count)</span></h2>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Review/Create?eventId=@Model.Id" class="btn-primary-custom" style="font-size:0.85rem;padding:8px 16px">
                            ⭐ Napiši recenziju
                        </a>
                    }
                    else
                    {
                        <a href="/prijava?returnUrl=/Event/Details/@Model.Id" class="btn-secondary-custom" style="font-size:0.85rem;padding:8px 16px">
                            🔐 Prijavi se za recenziju
                        </a>
                    }
                </div>
                @if (Model.Reviews.Any())
                {
                    <div class="review-avg">
                        <span class="review-avg-score">@Model.AverageRating.ToString("F1")</span>
                        <span class="star-rating">@(string.Concat(Enumerable.Repeat("★", (int)Math.Round(Model.AverageRating))))</span>
                    </div>
                    @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                    {
                        <div class="review-card">
                            <div class="review-header">
                                <div class="review-avatar">@review.User.Initials</div>
                                <div>
                                    <div class="review-author">@review.User.FullName</div>
                                    <div class="review-date">@review.CreatedAt.ToString("dd.MM.yyyy")</div>
                                </div>
                                <div class="star-rating review-stars">@review.Stars</div>
                            </div>
                            <p class="review-comment">@review.Comment</p>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted-ze">Još nema recenzija za ovaj event.</p>
                }
            </div>
        </div>

        <!-- Desno: cjenik + lokacija info -->
        <div class="event-detail-sidebar">
            <div class="detail-section">
                <h3>Lokacija</h3>
                <div class="venue-mini-card">
                    <img src="@Model.Venue.ImageUrl" alt="@Model.Venue.Name"
                         onerror="this.src='https://images.unsplash.com/photo-1566737236500-c8ac43014a67?w=400'" />
                    <div class="venue-mini-info">
                        <div class="venue-mini-name">@Model.Venue.Name</div>
                        <div class="venue-mini-addr">@Model.Venue.Address</div>
                        <div class="venue-mini-hours">🕐 @Model.Venue.WorkingHours</div>
                        <div class="venue-mini-phone">📞 @Model.Venue.ContactPhone</div>
                        <a href="/Venue/Details/@Model.Venue.Id" class="btn-secondary-custom" style="display:block;text-align:center;margin-top:12px">Detalji lokacije</a>
                    </div>
                </div>
            </div>

            <div class="detail-section">
                <h3>Cjenik</h3>
                <table class="ze-table" style="font-size:0.85rem">
                    <thead>
                        <tr><th>Artikl</th><th>Kategorija</th><th>Cijena</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Venue.PriceList)
                        {
                            <tr>
                                <td>@item.ItemName</td>
                                <td><span class="text-muted-ze">@item.Category</span></td>
                                <td style="color:#10b981;font-weight:600">@item.Price.ToString("F2") €</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ============= MODAL: TLOCRT + ZAUZETOST STOLOVA ============= *@
<div class="floorplan-modal" id="floorplanModal" hidden>
    <div class="floorplan-card">
        <div class="floorplan-head">
            <h3 style="margin:0">@Model.Venue.Name — tlocrt i zauzetost</h3>
            <button type="button" id="floorplanClose" class="floorplan-close" aria-label="Zatvori">✕</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Venue.FloorPlanUrl))
        {
            <div class="floorplan-wrap">
                <img src="@Model.Venue.FloorPlanUrl" alt="Tlocrt @Model.Venue.Name" class="floorplan-img" />
                @* Markeri zauzetosti direktno preko tlocrta (stolovi s poznatom pozicijom) *@
                @foreach (var table in Model.Venue.Tables.Where(t => t.PosX != null && t.PosY != null))
                {
                    bool isFree = freeTables.Any(ft => ft.Id == table.Id);
                    <span class="fp-marker @(isFree ? "fp-m-free" : "fp-m-taken")"
                          style="left:@(table.PosX!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))%;top:@(table.PosY!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))%"
                          title="Stol @table.TableNumber — @(isFree ? "slobodan" : "ZAUZET")">
                        @(isFree ? table.TableNumber.ToString() : "✕")
                    </span>
                }
            </div>
        }
        else
        {
            <div class="floorplan-missing">
                📐 Vlasnik još nije postavio tlocrt ove lokacije.
                @if (User.CanManageVenue(Model.Venue.OwnerAppUserId))
                {
                    <a href="/Venue/Edit/@Model.Venue.Id" style="color:#a78bfa">Dodaj tlocrt →</a>
                }
            </div>
        }
        <div class="floorplan-legend">
            <span><i class="dot dot-free"></i> Slobodan</span>
            <span><i class="dot dot-taken"></i> Zauzet</span>
            <span><i class="dot dot-vip"></i> VIP zona</span>
        </div>
        <div class="floorplan-tables">
            @foreach (var table in Model.Venue.Tables.OrderBy(t => t.TableNumber))
            {
                bool isFree = freeTables.Any(ft => ft.Id == table.Id);
                <span class="fp-chip @(isFree ? "fp-free" : "fp-taken")" title="@table.SeatCount mjesta">
                    @(table.Zone == TableZone.VIP ? "★" : "")@table.TableNumber
                </span>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        var btn = document.getElementById('floorplanBtn');
        var modal = document.getElementById('floorplanModal');
        var close = document.getElementById('floorplanClose');
        if (!btn || !modal) return;
        btn.addEventListener('click', function () { modal.hidden = false; });
        close.addEventListener('click', function () { modal.hidden = true; });
        modal.addEventListener('click', function (e) { if (e.target === modal) modal.hidden = true; });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') modal.hidden = true; });
    })();
</script>

<style>
/* Tlocrt: info gumb + modal */
/* Poruka kad rezervacija nije dopustena (dob / neprovjeren identitet) */
.reserve-block {
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.45);
    border-radius: 12px; padding: 16px 18px;
}
.reserve-block-title { font-weight: 700; color: #f59e0b; margin-bottom: 6px; }
.reserve-block-text { color: #cbd5e1; font-size: 0.9rem; margin: 0 0 14px; }

.floorplan-info-btn {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 6px 12px; border-radius: 18px; font-size: 0.78rem; font-weight: 600;
    background: rgba(6,182,212,0.12); border: 1px solid rgba(6,182,212,0.45); color: #22d3ee;
    cursor: pointer; transition: background 0.15s;
}
.floorplan-info-btn:hover { background: rgba(6,182,212,0.25); }
.floorplan-modal {
    position: fixed; inset: 0; z-index: 2000;
    display: flex; align-items: center; justify-content: center;
    background: rgba(5,5,10,0.78); backdrop-filter: blur(5px); padding: 20px;
}
/* display:flex bi pregazio hidden atribut - ovo vraca skrivanje */
.floorplan-modal[hidden] { display: none !important; }
.floorplan-card {
    background: #12121a; border: 1px solid rgba(124,58,237,0.4); border-radius: 16px;
    padding: 20px; max-width: 860px; width: 100%; max-height: 92vh; overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,0.7);
}
.floorplan-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
.floorplan-head h3 { color: #f1f5f9; font-size: 1.05rem; }
.floorplan-close { background: none; border: 1px solid rgba(255,255,255,0.15); color: #94a3b8; width: 32px; height: 32px; border-radius: 8px; cursor: pointer; }
.floorplan-close:hover { border-color: #ef4444; color: #ef4444; }
.floorplan-img { width: 100%; border-radius: 10px; border: 1px solid rgba(255,255,255,0.08); display: block; }
.floorplan-wrap { position: relative; }
/* Markeri zauzetosti preko tlocrta */
.fp-marker {
    position: absolute; transform: translate(-50%, -50%);
    width: 30px; height: 30px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.78rem; font-weight: 800; pointer-events: auto; cursor: default;
}
.fp-m-free { background: rgba(16,185,129,0.22); border: 2px solid #10b981; color: #6ee7b7; }
.fp-m-taken { background: rgba(239,68,68,0.85); border: 2px solid #fecaca; color: #fff; box-shadow: 0 0 10px rgba(239,68,68,0.8); }
.floorplan-missing { padding: 28px; text-align: center; color: #94a3b8; background: #0d0d15; border: 1px dashed rgba(255,255,255,0.15); border-radius: 10px; }
.floorplan-legend { display: flex; gap: 18px; margin: 12px 0 8px; color: #94a3b8; font-size: 0.78rem; }
.floorplan-legend .dot { display: inline-block; width: 11px; height: 11px; border-radius: 50%; margin-right: 5px; }
.dot-free { background: #10b981; }
.dot-taken { background: #ef4444; }
.dot-vip { background: transparent; border: 2px solid #facc15; width: 9px !important; height: 9px !important; }
.floorplan-tables { display: flex; flex-wrap: wrap; gap: 7px; }
.fp-chip {
    min-width: 38px; text-align: center; padding: 6px 8px; border-radius: 8px;
    font-size: 0.82rem; font-weight: 700;
}
.fp-free { background: rgba(16,185,129,0.14); color: #34d399; border: 1px solid rgba(16,185,129,0.45); }
.fp-taken { background: rgba(239,68,68,0.12); color: #f87171; border: 1px solid rgba(239,68,68,0.4); text-decoration: line-through; opacity: 0.75; }

.event-detail-hero {
    position: relative;
    height: 420px;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 32px;
}

.event-detail-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.event-detail-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,10,15,0.95) 0%, rgba(10,10,15,0.3) 60%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px 32px;
}

.event-detail-title {
    font-size: 2.2rem;
    font-weight: 700;
    color: #f1f5f9;
    margin: 10px 0 8px;
}

.event-detail-venue-link a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.95rem;
}

.event-detail-venue-link a:hover { color: #7c3aed; }

.event-detail-content {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 32px;
    align-items: start;
}

.event-info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

.stat-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: #64748b; margin-bottom: 4px; }
.stat-value { font-size: 1.3rem; font-weight: 700; color: #f1f5f9; }
.stat-sub { font-size: 0.8rem; color: #94a3b8; margin-top: 2px; }

.tables-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
    margin-bottom: 20px;
}

.table-card {
    background: #12121a;
    border: 1px solid rgba(124,58,237,0.2);
    border-radius: 10px;
    padding: 12px;
    text-align: center;
}

.table-card.table-taken {
    opacity: 0.4;
    border-color: rgba(239,68,68,0.2);
}

.table-number { font-weight: 600; font-size: 0.9rem; color: #f1f5f9; margin-bottom: 4px; }
.table-seats { font-size: 0.78rem; color: #94a3b8; margin: 4px 0; }
.table-status { font-size: 0.75rem; font-weight: 600; color: #10b981; }
.table-taken .table-status { color: #ef4444; }

.zone-vip { display: inline-block; padding: 2px 8px; border-radius: 10px; background: rgba(124,58,237,0.2); color: #7c3aed; font-size: 0.7rem; font-weight: 600; }
.zone-regular { display: inline-block; padding: 2px 8px; border-radius: 10px; background: rgba(6,182,212,0.15); color: #06b6d4; font-size: 0.7rem; font-weight: 600; }

.reservation-form .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.form-group { margin-bottom: 16px; }

.review-avg { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
