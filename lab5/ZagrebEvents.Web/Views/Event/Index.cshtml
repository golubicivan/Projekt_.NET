@model List<Event>
@{
    ViewData["Title"] = "Svi eventi";
    var isAdmin = User.IsInRole("Admin");
}

@section Breadcrumbs {
<nav class="ze-breadcrumb">
    <a href="/">Karta</a> › <span>Svi eventi</span>
</nav>
}

<div class="ze-page-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px">
    <div>
        <h1>Svi eventi</h1>
        <p class="text-muted-ze">Pretraži po nazivu eventa ili lokaciji</p>
    </div>
    @if (isAdmin)
    {
        <a href="/Event/Create" class="btn-primary-custom">➕ Novi event</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="ze-alert-success" style="margin-bottom:16px">✓ @TempData["Success"]</div>
}

@{ int? selType = ViewBag.Type as int?; }
<form data-ajax-search="/Event/SearchPartial"
      data-target="#event-list"
      class="ze-search-form"
      style="margin-bottom:24px;display:flex;gap:12px;flex-wrap:wrap">
    <div style="position:relative;flex:1;min-width:220px">
        <input type="text" name="q" value="@ViewBag.Query"
               placeholder="Pretraži evente..."
               class="ze-input"
               style="padding-left:42px"
               autocomplete="off" />
        <span style="position:absolute;left:14px;top:13px;opacity:0.5">🔍</span>
    </div>
    <select name="type" class="ze-input" style="max-width:200px">
        <option value="">Svi tipovi</option>
        <option value="0" selected="@(selType == 0)">🪩 DJ Noć</option>
        <option value="1" selected="@(selType == 1)">🎤 Koncert</option>
        <option value="2" selected="@(selType == 2)">📖 Pub Quiz</option>
        <option value="3" selected="@(selType == 3)">🎪 Festival</option>
    </select>
</form>

<div id="event-list">
    @await Html.PartialAsync("_EventListPartial", Model)
</div>

@if (isAdmin && Model.Any())
{
    <div style="margin-top:24px;padding:16px;background:#12121a;border:1px solid rgba(124,58,237,0.3);border-radius:10px">
        <strong style="color:#7c3aed;font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em">Admin akcije:</strong>
        <div style="margin-top:10px;display:flex;flex-wrap:wrap;gap:8px">
            @foreach (var ev in Model)
            {
                <span style="display:inline-flex;align-items:center;gap:4px;background:#0a0a0f;padding:6px 10px;border-radius:8px;border:1px solid rgba(124,58,237,0.2)">
                    <span style="font-size:0.85rem">@ev.Name</span>
                    <a href="/Event/Edit/@ev.Id" class="btn-mini btn-edit" title="Uredi">✎</a>
                    <form method="post" action="/Event/Delete/@ev.Id" style="display:inline" data-confirm-delete="Obrisati event @ev.Name?">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-mini btn-del" title="Obriši">🗑️</button>
                    </form>
                </span>
            }
        </div>
    </div>
}

<style>
.event-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
    padding: 0 0 48px;
}
.event-card-link { text-decoration: none; color: inherit; display: block; }
.event-card {
    background: #1a1a2e; border-radius: 16px;
    border: 1px solid rgba(124,58,237,0.2); overflow: hidden;
    transition: all 0.3s ease;
}
.event-card:hover {
    border-color: rgba(124,58,237,0.6);
    box-shadow: 0 8px 32px rgba(124,58,237,0.2);
    transform: translateY(-4px);
}
.event-card-poster { position: relative; aspect-ratio: 16/9; overflow: hidden; }
.event-card-poster img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
.event-card:hover .event-card-poster img { transform: scale(1.05); }
.event-badge {
    position: absolute; top: 10px; left: 10px;
    padding: 4px 10px; border-radius: 20px;
    font-size: 0.72rem; font-weight: 600; color: #fff;
    text-transform: uppercase; letter-spacing: 0.06em;
}
.event-badge-past {
    position: absolute; top: 10px; right: 10px;
    padding: 4px 10px; border-radius: 20px;
    font-size: 0.72rem; font-weight: 600;
    background: rgba(0,0,0,0.6); color: #94a3b8;
}
.event-card-body { padding: 16px; }
.event-card-title { font-size: 1.05rem; font-weight: 600; color: #f1f5f9; margin: 0 0 8px; line-height: 1.3; }
.event-card-venue { font-size: 0.82rem; color: #94a3b8; margin-bottom: 10px; }
.event-card-meta { display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: #64748b; }
.event-card-price { color: #10b981; font-weight: 600; }
.btn-mini {
    background: transparent; border: none; cursor: pointer;
    padding: 2px 4px; border-radius: 4px;
    font-size: 0.85rem; text-decoration: none;
    transition: all 0.15s;
}
.btn-mini:hover { background: rgba(124,58,237,0.2); }
.btn-del:hover { background: rgba(239,68,68,0.2); }
.ze-empty-state { text-align: center; padding: 60px 20px; }
</style>
