@model User
@{
    ViewData["Title"] = Model.FullName;
    var currentUserId = User.GetDomainUserId() ?? 0;
    var canEdit = currentUserId == Model.Id || User.IsInRole("Admin");
}

@if (TempData["Success"] != null)
{
    <div class="ze-alert-success" style="margin-bottom:16px">✓ @TempData["Success"]</div>
}

@if (canEdit)
{
    <div style="display:flex;gap:8px;margin-bottom:16px;justify-content:flex-end">
        <a href="/User/Edit/@Model.Id" class="btn-primary-custom" style="font-size:0.85rem;padding:8px 16px">✎ Uredi profil</a>
        @if (User.IsInRole("Admin") && currentUserId != Model.Id)
        {
            <form method="post" action="/User/Delete/@Model.Id" style="display:inline"
                  data-confirm-delete="Obrisati korisnika '@Model.FullName'?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-danger-custom" style="font-size:0.85rem;padding:8px 16px">🗑️ Obriši (soft)</button>
            </form>
        }
    </div>
}

@section Breadcrumbs {
<nav class="ze-breadcrumb">
    <a href="/">Karta</a> › <a href="/User/Index">Korisnici</a> › <span>@Model.FullName</span>
</nav>
}

<div class="user-profile">
    <div class="user-header detail-section">
        <div class="user-avatar-lg">@Model.Initials</div>
        <div class="user-header-info">
            <h1>@Model.FullName</h1>
            <span class="@(Model.Role == UserRole.Admin ? "zone-vip" : Model.Role == UserRole.Owner ? "zone-regular" : "")">@Model.Role</span>
            <div class="user-meta-row">
                <span>📧 @Model.Email</span>
                <span>📞 @Model.PhoneNumber</span>
                <span>🎂 @Model.DateOfBirth.ToString("dd.MM.yyyy") (@Model.Age god.)</span>
                <span>📅 Registriran: @Model.RegisteredAt.ToString("dd.MM.yyyy")</span>
            </div>
            @if (!Model.IsAdult)
            {
                <div class="ze-alert-danger" style="margin-top:10px">⚠️ Maloljetni korisnik — ograničen pristup 18+ eventima</div>
            }
            @{
                var idDoc = ViewBag.IdentityDocument as string;
                var idDocBack = ViewBag.IdentityDocumentBack as string;
            }
            @if (User.IsInRole("Admin") && !string.IsNullOrEmpty(idDoc))
            {
                <div class="id-doc-box">
                    <span>🪪 Priloženi dokument (dob/identitet):</span>
                    <a href="@idDoc" target="_blank" rel="noopener">
                        <img src="@idDoc" alt="Prednja strana" class="id-doc-thumb" />
                        Prednja ↗
                    </a>
                    @if (!string.IsNullOrEmpty(idDocBack))
                    {
                        <a href="@idDocBack" target="_blank" rel="noopener">
                            <img src="@idDocBack" alt="Stražnja strana" class="id-doc-thumb" />
                            Stražnja ↗
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    @if (User.IsInRole("Admin") && currentUserId != Model.Id)
    {
        var allVenues = ViewBag.AllVenues as List<Venue> ?? new List<Venue>();
        int? ownedVenueId = ViewBag.OwnedVenueId as int?;
        var roleStr = Model.Role.ToString();
        <div class="detail-section admin-roles">
            <h2>🛡️ Administracija — uloga i vlasništvo</h2>
            <form method="post" action="/User/SetRole/@Model.Id" class="role-form">
                @Html.AntiForgeryToken()
                <div class="role-row">
                    <div class="form-group" style="flex:1">
                        <label class="ze-label">Uloga</label>
                        <select name="role" id="roleSelect" class="ze-input">
                            <option value="Guest" selected="@(roleStr == "Guest")">Guest (gost)</option>
                            <option value="Owner" selected="@(roleStr == "Owner")">Owner (vlasnik lokacije)</option>
                            <option value="Admin" selected="@(roleStr == "Admin")">Admin</option>
                        </select>
                    </div>
                    <div class="form-group" style="flex:1" id="venuePickWrap">
                        <label class="ze-label">Dodijeli lokaciju (za Ownera)</label>
                        <select name="venueId" class="ze-input">
                            <option value="">— bez lokacije —</option>
                            @foreach (var v in allVenues)
                            {
                                <option value="@v.Id" selected="@(ownedVenueId == v.Id)">@v.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn-primary-custom" style="margin-top:8px">Spremi ulogu</button>
                <p class="text-muted-ze" style="font-size:0.78rem;margin-top:8px">
                    Promjena uloge stupa na snagu nakon što se korisnik ponovno prijavi.
                </p>
            </form>
        </div>
        <script>
            (function () {
                var sel = document.getElementById('roleSelect');
                var wrap = document.getElementById('venuePickWrap');
                function sync() { wrap.style.display = sel.value === 'Owner' ? '' : 'none'; }
                sel.addEventListener('change', sync); sync();
            })();
        </script>
    }

    <div class="user-content-grid">
        <div>
            <div class="detail-section">
                <h2>Rezervacije (@Model.Reservations.Count)</h2>
                @if (Model.Reservations.Any())
                {
                    @foreach (var res in Model.Reservations.OrderByDescending(r => r.CreatedAt))
                    {
                        <div class="venue-event-row" style="margin-bottom:8px">
                            <div>
                                <div style="font-weight:600;color:#f1f5f9">@res.Event.Name</div>
                                <div class="text-muted-ze" style="font-size:0.78rem">@res.Event.Venue.Name · @res.Event.StartTime.ToString("dd.MM.yyyy")</div>
                            </div>
                            <span>👥 @res.NumberOfGuests gostiju</span>
                            <span style="color:@res.StatusColor;font-weight:600">@res.StatusLabel</span>
                            <a href="/Reservation/Details/@res.Id" class="btn-secondary-custom" style="padding:4px 10px;font-size:0.78rem">Detalji</a>
                        </div>
                    }
                }
                else { <p class="text-muted-ze">Nema rezervacija.</p> }
            </div>

            <div class="detail-section">
                <h2>Recenzije (@Model.Reviews.Count)</h2>
                @if (Model.Reviews.Any())
                {
                    @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                    {
                        <div class="review-card">
                            <div class="review-header">
                                <div><div style="font-weight:600;color:#f1f5f9">@review.Event.Name</div><div class="review-date">@review.CreatedAt.ToString("dd.MM.yyyy")</div></div>
                                <div class="star-rating review-stars">@review.Stars</div>
                            </div>
                            <p class="review-comment">@review.Comment</p>
                        </div>
                    }
                }
                else { <p class="text-muted-ze">Nema recenzija.</p> }
            </div>
        </div>

        <div>
            <div class="detail-section">
                <h2>Omiljene lokacije</h2>
                @if (Model.FavoriteVenues.Any())
                {
                    @foreach (var venue in Model.FavoriteVenues)
                    {
                        <a href="/Venue/Details/@venue.Id" class="venue-event-row" style="margin-bottom:8px;display:flex">
                            <span style="font-size:1.2rem">❤️</span>
                            <span style="font-weight:600;color:#f1f5f9">@venue.Name</span>
                            <span class="text-muted-ze" style="font-size:0.8rem">@venue.Address</span>
                        </a>
                    }
                }
                else { <p class="text-muted-ze">Nema omiljenih lokacija.</p> }
            </div>
        </div>
    </div>
</div>

<style>
.user-header { display: flex; align-items: flex-start; gap: 24px; }
.user-avatar-lg { width: 80px; height: 80px; border-radius: 50%; background: #7c3aed; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; font-weight: 700; flex-shrink: 0; }
.user-header-info h1 { margin: 0 0 8px; font-size: 1.8rem; }
.user-meta-row { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 10px; font-size: 0.85rem; color: #94a3b8; }
.user-content-grid { display: grid; grid-template-columns: 1fr 300px; gap: 24px; margin-top: 24px; }
.review-card { background: #12121a; border-radius: 12px; padding: 14px; margin-bottom: 10px; border: 1px solid rgba(255,255,255,0.06); }
.review-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.review-date { font-size: 0.75rem; color: #64748b; }
.review-stars { color: #f59e0b; }
.review-comment { color: #94a3b8; font-size: 0.88rem; margin: 0; }
.zone-vip { display: inline-block; padding: 2px 10px; border-radius: 10px; background: rgba(124,58,237,0.2); color: #7c3aed; font-size: 0.75rem; font-weight: 600; }
.zone-regular { display: inline-block; padding: 2px 10px; border-radius: 10px; background: rgba(6,182,212,0.15); color: #06b6d4; font-size: 0.75rem; font-weight: 600; }
.id-doc-box { margin-top: 12px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 0.85rem; color: #94a3b8; }
.id-doc-box a { display: inline-flex; align-items: center; gap: 8px; color: #a78bfa; text-decoration: none; font-weight: 600; }
.id-doc-thumb { width: 64px; height: 44px; object-fit: cover; border-radius: 6px; border: 1px solid rgba(124,58,237,0.4); }
.admin-roles { border: 1px solid rgba(124,58,237,0.35); background: rgba(124,58,237,0.06); margin-top: 16px; }
.role-row { display: flex; gap: 16px; flex-wrap: wrap; }
@@media (max-width: 768px) { .user-content-grid { grid-template-columns: 1fr; } .user-header { flex-direction: column; } .role-row { flex-direction: column; } }
</style>
