@{
    ViewData["Title"] = "Prijava";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Prijava</h1>
            <p class="text-muted-ze">Dobrodošao natrag u GdjeCemo</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="ze-alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" action="/prijava" class="ze-form">
            @Html.AntiForgeryToken()
            @if (!string.IsNullOrEmpty(returnUrl))
            {
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            }

            <div class="form-group">
                <label class="ze-label">Email</label>
                <input type="email" name="email" class="ze-input" placeholder="ivan.golubic@email.com" required autofocus />
            </div>

            <div class="form-group">
                <label class="ze-label">Lozinka</label>
                <input type="password" name="password" class="ze-input" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn-primary-custom" style="width:100%;margin-top:8px">Prijavi se</button>
        </form>

        <div class="auth-divider"><span>ili</span></div>

        <form method="post" action="/Account/ExternalLogin" class="ze-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="provider" value="Google" />
            @if (!string.IsNullOrEmpty(returnUrl))
            {
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            }
            <button type="submit" class="btn-google" style="width:100%">
                <svg width="18" height="18" viewBox="0 0 48 48" style="vertical-align:middle;margin-right:8px">
                    <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.4 29.3 35 24 35c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.3 5.1 29.4 3 24 3 12.4 3 3 12.4 3 24s9.4 21 21 21 21-9.4 21-21c0-1.2-.1-2.3-.4-3.5z"/>
                    <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.3 5.1 29.4 3 24 3 16 3 9.1 7.6 6.3 14.7z"/>
                    <path fill="#4CAF50" d="M24 45c5.2 0 10-2 13.6-5.2l-6.3-5.3C29.2 35.9 26.7 37 24 37c-5.3 0-9.7-2.6-11.3-7l-6.5 5C9.1 42.3 16 45 24 45z"/>
                    <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.2-4.3 5.5l6.3 5.3C39.5 39.6 45 33 45 24c0-1.2-.1-2.3-.4-3.5z"/>
                </svg>
                Prijavi se s Google
            </button>
        </form>

        <div class="auth-footer">
            <p class="text-muted-ze">Nemaš account? <a href="/registracija" style="color:#7c3aed">Registriraj se</a></p>
        </div>

        <div class="auth-demo">
            <div class="demo-title">Demo lozinke za prototip:</div>
            <div class="demo-row"><strong>ivan.golubic@email.com</strong> / <code>ivan123</code> (Guest)</div>
            <div class="demo-row"><strong>luka.peric@admin.com</strong> / <code>admin123</code> (Admin)</div>
        </div>
    </div>
</div>

<style>
.auth-page { max-width: 480px; margin: 60px auto; padding: 0 20px; }
.auth-card { background: #12121a; border: 1px solid rgba(124,58,237,0.3); border-radius: 16px; padding: 32px; }
.auth-header { text-align: center; margin-bottom: 28px; }
.auth-header h1 { font-size: 1.8rem; font-weight: 700; color: #f1f5f9; margin: 0 0 6px; }
.auth-footer { margin-top: 22px; text-align: center; font-size: 0.9rem; }
.auth-footer a { text-decoration: none; font-weight: 600; }
.auth-footer a:hover { text-decoration: underline; }
.auth-demo {
    margin-top: 22px; padding: 14px; background: #0a0a0f;
    border: 1px dashed rgba(124,58,237,0.3); border-radius: 10px;
    font-size: 0.78rem; color: #94a3b8;
}
.demo-title { font-weight: 600; color: #7c3aed; margin-bottom: 6px; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.05em; }
.demo-row { margin-bottom: 4px; }
.demo-row code { background: #1a1a2e; padding: 1px 6px; border-radius: 4px; color: #06b6d4; font-family: 'Courier New', monospace; }
.auth-divider { display: flex; align-items: center; text-align: center; margin: 18px 0; color: #64748b; font-size: 0.8rem; }
.auth-divider::before, .auth-divider::after { content: ''; flex: 1; border-bottom: 1px solid rgba(255,255,255,0.1); }
.auth-divider span { padding: 0 12px; }
.btn-google {
    background: #fff; color: #1f1f1f; border: none; border-radius: 8px;
    padding: 11px 20px; font-weight: 600; font-size: 0.95rem; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    transition: background 0.15s;
}
.btn-google:hover { background: #f1f1f1; }
</style>
