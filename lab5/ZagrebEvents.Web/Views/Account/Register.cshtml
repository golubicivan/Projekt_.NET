@{
    ViewData["Title"] = "Registracija";
    // Nakon serverske greske zadrzi unesene vrijednosti (osim lozinki i datoteka)
    var form = Context.Request.HasFormContentType ? Context.Request.Form : null;
    DateTime.TryParse(form?["dateOfBirth"], out var enteredDob);
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Registracija</h1>
            <p class="text-muted-ze">Kreiraj novi account u GdjeCemo</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="ze-alert-danger">
                <strong>Registracija nije uspjela:</strong>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>• @error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" action="/registracija" class="ze-form" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="form-row">
                <div class="form-group">
                    <label class="ze-label">Ime</label>
                    <input type="text" name="firstName" value="@(form?["firstName"])" class="ze-input" placeholder="Ivan" required />
                </div>
                <div class="form-group">
                    <label class="ze-label">Prezime</label>
                    <input type="text" name="lastName" value="@(form?["lastName"])" class="ze-input" placeholder="Horvat" required />
                </div>
            </div>

            <div class="form-group">
                <label class="ze-label">Email</label>
                <input type="email" name="email" value="@(form?["email"])" class="ze-input" placeholder="ime.prezime@email.com" required />
            </div>

            <div class="form-group">
                <label class="ze-label">OIB (11 znamenki)</label>
                <input type="text" name="oib" value="@(form?["oib"])" class="ze-input" pattern="[0-9]{11}" maxlength="11" placeholder="12345678901" required />
                @Html.ValidationMessage("oib", null, new { @class = "field-error" })
            </div>

            <div id="docFields">
                <div class="form-group">
                    <label class="ze-label">Prednja strana osobne *</label>
                    <input type="file" name="documentFront" class="ze-input ze-file" accept="image/*" required />
                    <small class="text-muted-ze" style="font-size:0.78rem">Strana s imenom, prezimenom i datumom rođenja (JPG/PNG, max 5 MB).</small>
                    <div class="field-error js-file-error"></div>
                    @Html.ValidationMessage("documentFront", null, new { @class = "field-error" })
                </div>

                <div class="form-group">
                    <label class="ze-label">Stražnja strana osobne *</label>
                    <input type="file" name="documentBack" class="ze-input ze-file" accept="image/*" required />
                    <small class="text-muted-ze" style="font-size:0.78rem">Strana s OIB-om.<br />🤖 AI provjerava da se ime, datum rođenja i OIB podudaraju s dokumentom.</small>
                    <div class="field-error js-file-error"></div>
                    @Html.ValidationMessage("documentBack", null, new { @class = "field-error" })
                </div>
            </div>

            <div class="skip-doc">
                <label class="skip-doc-label">
                    <input type="checkbox" name="skipDocument" id="skipDocument" value="true" />
                    <span>Ne želim sada priložiti osobnu iskaznicu</span>
                </label>
                <small class="text-muted-ze" style="font-size:0.78rem;display:block;margin-top:6px">
                    Bez potvrđenog identiteta možeš rezervirati stolove samo na eventima <b>bez dobne granice</b>
                    — te u klubovima koji ne traže potvrdu identiteta. Osobnu možeš priložiti kasnije u profilu.
                </small>
            </div>

            <div class="form-row">
                <div class="form-group">
                    @await Html.PartialAsync("_DatePicker", new ZagrebEvents.Web.Models.DatePickerModel
                    {
                        Name = "dateOfBirth",
                        Label = "Datum rođenja",
                        Value = enteredDob == default ? (DateTime?)null : enteredDob,
                        IncludeTime = false,
                        Required = true
                    })
                    @Html.ValidationMessage("dateOfBirth", null, new { @class = "field-error" })
                </div>
                <div class="form-group">
                    <label class="ze-label">Telefon (opcionalno)</label>
                    <input type="tel" name="phoneNumber" value="@(form?["phoneNumber"])" class="ze-input" placeholder="+385..." />
                </div>
            </div>

            <div class="form-group">
                <label class="ze-label">Lozinka (min. 6 znakova)</label>
                <input type="password" name="password" class="ze-input" minlength="6" required />
            </div>

            <div class="form-group">
                <label class="ze-label">Potvrdi lozinku</label>
                <input type="password" name="passwordConfirm" class="ze-input" minlength="6" required />
            </div>

            <button type="submit" class="btn-primary-custom" id="regSubmit" style="width:100%;margin-top:8px">Registriraj se</button>
        </form>

        <script>
            // Preskakanje osobne: sakrij polja i makni "required"
            var skipCb = document.getElementById('skipDocument');
            var docFields = document.getElementById('docFields');
            function toggleDocFields() {
                var skip = skipCb.checked;
                docFields.style.display = skip ? 'none' : '';
                docFields.querySelectorAll('input[type=file]').forEach(function (i) {
                    i.required = !skip;
                    if (skip) i.value = '';
                });
            }
            skipCb.addEventListener('change', toggleDocFields);
            toggleDocFields();

            // Klijentska provjera slika PRIJE uploada: odmah jasna poruka umjesto cekanja servera
            document.querySelector('.ze-form').addEventListener('submit', function (e) {
                if (skipCb.checked) { document.getElementById('regSubmit').disabled = true; return; }
                var ok = true;
                ['documentFront', 'documentBack'].forEach(function (name) {
                    var input = document.querySelector('input[name=' + name + ']');
                    var msg = input.parentElement.querySelector('.js-file-error');
                    msg.textContent = '';
                    var f = input.files[0];
                    if (!f) {
                        msg.textContent = '⚠️ Priloži sliku ' + (name === 'documentFront' ? 'prednje' : 'stražnje') + ' strane osobne.';
                        ok = false;
                    } else if (f.size > 5 * 1024 * 1024) {
                        msg.textContent = '⚠️ Slika je prevelika (' + (f.size / 1024 / 1024).toFixed(1) + ' MB, max 5 MB) — smanji je ili fotografiraj u nižoj rezoluciji.';
                        ok = false;
                    }
                });
                if (!ok) { e.preventDefault(); return; }
                var btn = document.getElementById('regSubmit');
                btn.disabled = true;
                btn.textContent = '🤖 AI provjerava dokument…';
            });
        </script>

        <div class="auth-footer">
            <p class="text-muted-ze">Već imaš account? <a href="/prijava" style="color:#7c3aed">Prijavi se</a></p>
        </div>
    </div>
</div>

<style>
.auth-page { max-width: 540px; margin: 40px auto; padding: 0 20px; }
.auth-card { background: #12121a; border: 1px solid rgba(124,58,237,0.3); border-radius: 16px; padding: 32px; }
.auth-header { text-align: center; margin-bottom: 24px; }
.auth-header h1 { font-size: 1.8rem; font-weight: 700; color: #f1f5f9; margin: 0 0 6px; }
.auth-footer { margin-top: 22px; text-align: center; font-size: 0.9rem; }
.auth-footer a { text-decoration: none; font-weight: 600; }
.auth-footer a:hover { text-decoration: underline; }
.skip-doc { background: #0d0d14; border: 1px dashed rgba(148,163,184,0.35); border-radius: 10px; padding: 12px 14px; margin-bottom: 16px; }
.skip-doc-label { display: flex; align-items: center; gap: 9px; cursor: pointer; font-size: 0.88rem; color: #e2e8f0; }
.skip-doc-label input { width: 17px; height: 17px; accent-color: #7c3aed; cursor: pointer; }
.field-error { color: #f87171; font-size: 0.8rem; margin-top: 4px; }
.field-error:empty { display: none; }
.ze-file { padding: 10px; cursor: pointer; }
.ze-file::file-selector-button { background: rgba(124,58,237,0.2); color: #a78bfa; border: none; padding: 6px 12px; border-radius: 6px; margin-right: 10px; cursor: pointer; font-weight: 600; }
</style>
