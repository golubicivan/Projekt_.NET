@model List<User>
@{
    ViewData["Title"] = "Korisnici";
}

@section Breadcrumbs {
<nav class="ze-breadcrumb"><a href="/">Karta</a> › <span>Korisnici</span></nav>
}

<div class="ze-page-header">
    <h1>Korisnici</h1>
    <p class="text-muted-ze">Pretraži po imenu, prezimenu ili emailu</p>
</div>

@if (TempData["Success"] != null) { <div class="ze-alert-success" style="margin-bottom:16px">✓ @TempData["Success"]</div> }

<form data-ajax-search="/User/SearchPartial" data-target="#user-list" style="margin-bottom:24px">
    <div style="position:relative">
        <input type="text" name="q" value="@ViewBag.Query" placeholder="Pretraži korisnike..."
               class="ze-input" style="padding-left:42px" autocomplete="off" />
        <span style="position:absolute;left:14px;top:13px;opacity:0.5">🔍</span>
    </div>
</form>

<div id="user-list">
    @await Html.PartialAsync("_UserListPartial", Model)
</div>
