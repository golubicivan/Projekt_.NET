@model Table
@{ ViewData["Title"] = "Novi stol"; }

@section Breadcrumbs {
<nav class="ze-breadcrumb"><a href="/">Karta</a> › <a href="/stolovi">Stolovi</a> › <span>Novi</span></nav>
}

<div class="ze-page-header"><h1>Novi stol</h1></div>

<form asp-action="Create" asp-controller="Table" method="post" class="ze-form" style="max-width:600px">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="ze-alert-danger" style="margin-bottom:16px"></div>

    <div class="form-row">
        <div class="form-group">
            <label asp-for="TableNumber" class="ze-label">Broj stola *</label>
            <input asp-for="TableNumber" type="number" min="1" class="ze-input" required />
            <span asp-validation-for="TableNumber" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="SeatCount" class="ze-label">Broj mjesta *</label>
            <input asp-for="SeatCount" type="number" min="1" max="50" class="ze-input" required />
            <span asp-validation-for="SeatCount" class="text-danger"></span>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label asp-for="Zone" class="ze-label">Zona</label>
            <select asp-for="Zone" class="ze-input">
                <option value="0">Regular</option>
                <option value="1">VIP</option>
            </select>
        </div>
        <div class="form-group">
            @await Html.PartialAsync("_AutocompleteDropdown", new ZagrebEvents.Web.Models.AutocompleteModel
            {
                Name = "VenueId",
                Endpoint = "/Api/SearchVenues",
                Label = "Lokacija",
                Placeholder = "Upiši ime lokacije...",
                Required = true
            })
        </div>
    </div>

    <div style="display:flex;gap:12px;margin-top:24px">
        <button type="submit" class="btn-primary-custom" style="flex:1">Kreiraj</button>
        <a href="/stolovi" class="btn-secondary-custom" style="flex:1;text-align:center">Odustani</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
