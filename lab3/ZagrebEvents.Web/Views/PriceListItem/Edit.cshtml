@model PriceListItem
@{ ViewData["Title"] = $"Uredi: {Model.ItemName}"; }

@section Breadcrumbs {
<nav class="ze-breadcrumb"><a href="/">Karta</a> › <a href="/cjenik">Cjenik</a> › <span>@Model.ItemName</span></nav>
}

<div class="ze-page-header"><h1>Uredi: @Model.ItemName</h1></div>

<form asp-action="Edit" asp-controller="PriceListItem" asp-route-id="@Model.Id" method="post" class="ze-form" style="max-width:600px">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="ze-alert-danger" style="margin-bottom:16px"></div>

    <div class="form-group">
        <label asp-for="ItemName" class="ze-label">Naziv artikla *</label>
        <input asp-for="ItemName" class="ze-input" required />
    </div>

    <div class="form-row">
        <div class="form-group">
            <label asp-for="Price" class="ze-label">Cijena (€) *</label>
            <input asp-for="Price" type="number" step="0.10" min="0" class="ze-input" required />
        </div>
        <div class="form-group">
            <label asp-for="Category" class="ze-label">Kategorija</label>
            <input asp-for="Category" class="ze-input" />
        </div>
    </div>

    @await Html.PartialAsync("_AutocompleteDropdown", new ZagrebEvents.Web.Models.AutocompleteModel
    {
        Name = "VenueId",
        InitialId = Model.VenueId,
        InitialLabel = Model.Venue?.Name ?? "",
        Endpoint = "/Api/SearchVenues",
        Label = "Lokacija",
        Required = true
    })

    <div style="display:flex;gap:12px;margin-top:24px">
        <button type="submit" class="btn-primary-custom" style="flex:1">Spremi</button>
        <a href="/cjenik" class="btn-secondary-custom" style="flex:1;text-align:center">Odustani</a>
    </div>
</form>

<form method="post" action="/PriceListItem/Delete/@Model.Id"
      data-confirm-delete="Obrisati '@Model.ItemName'?" style="max-width:600px;margin-top:16px">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn-danger-custom" style="width:100%">🗑️ Obriši</button>
</form>

<style>.btn-danger-custom { background: rgba(239,68,68,0.15); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; padding: 10px 20px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
.btn-danger-custom:hover { background: #ef4444; color: #fff; }</style>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
