@model List<Venue>
@{
    ViewData["Title"] = "Lokacije";
    var isAdmin = User.IsInRole("Admin");
}

@section Breadcrumbs {
<nav class="ze-breadcrumb"><a href="/">Karta</a> › <span>Lokacije</span></nav>
}

<div class="ze-page-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px">
    <div>
        <h1>Lokacije</h1>
        <p class="text-muted-ze">Pretraži po imenu ili adresi</p>
    </div>
    @if (isAdmin)
    {
        <a href="/Venue/Create" class="btn-primary-custom">➕ Nova lokacija</a>
    }
</div>

@if (TempData["Success"] != null) { <div class="ze-alert-success" style="margin-bottom:16px">✓ @TempData["Success"]</div> }

<form data-ajax-search="/Venue/SearchPartial" data-target="#venue-list" style="margin-bottom:24px">
    <div style="position:relative">
        <input type="text" name="q" value="@ViewBag.Query" placeholder="Pretraži lokacije..."
               class="ze-input" style="padding-left:42px" autocomplete="off" />
        <span style="position:absolute;left:14px;top:13px;opacity:0.5">🔍</span>
    </div>
</form>

<div id="venue-list">
    @await Html.PartialAsync("_VenueListPartial", Model)
</div>

@if (isAdmin && Model.Any())
{
    <div style="margin-top:24px;padding:16px;background:#12121a;border:1px solid rgba(6,182,212,0.3);border-radius:10px">
        <strong style="color:#06b6d4;font-size:0.85rem;text-transform:uppercase">Admin akcije:</strong>
        <div style="margin-top:10px;display:flex;flex-wrap:wrap;gap:8px">
            @foreach (var v in Model)
            {
                <span style="display:inline-flex;align-items:center;gap:4px;background:#0a0a0f;padding:6px 10px;border-radius:8px;border:1px solid rgba(6,182,212,0.2)">
                    <span style="font-size:0.85rem">@v.Name</span>
                    <a href="/Venue/Edit/@v.Id" class="btn-mini btn-edit" title="Uredi">✎</a>
                    <form method="post" action="/Venue/Delete/@v.Id" style="display:inline" data-confirm-delete="Obrisati lokaciju @v.Name?">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-mini btn-del" title="Obriši">🗑️</button>
                    </form>
                </span>
            }
        </div>
    </div>
}

<style>
.btn-mini { background: transparent; border: none; cursor: pointer; padding: 2px 4px; border-radius: 4px; font-size: 0.85rem; text-decoration: none; transition: all 0.15s; }
.btn-mini:hover { background: rgba(6,182,212,0.2); }
.btn-del:hover { background: rgba(239,68,68,0.2); }
</style>
